<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);WEB_EXPORT</DefineConstants>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <ProjectReference Include="../WebExport/WebExport.csproj" />
    <ProjectReference Include="../CSPlotlySlim/CSPlotlySlim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/ExportDemoScenes.cs" Link="Shared/ExportDemoScenes.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/PreparationTests.cs" Link="Shared/PreparationTests.cs" />
  </ItemGroup>
</Project>
